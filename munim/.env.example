# Copy this file to .env and paste your key.
SARVAM_API_KEY=

# Brain: auto (LLM if a key is set, offline rules as backup) | llm | rules
BRAIN=auto

# Chat model. Defaults to Sarvam's own model with the same key. Any OpenAI-compatible API with tool calling works.
# LLM_BASE_URL=https://api.sarvam.ai/v1
# LLM_MODEL=sarvam-105b
# LLM_API_KEY=

# Voice
# SARVAM_STT_MODEL=saaras:v3
# SARVAM_STT_MODE=translit
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=

# Demo pacing: seconds between Munim's steps so the audience can follow (0 = full speed)
STEP_DELAY=0.7
REFUND_APPROVAL_LIMIT=2000
